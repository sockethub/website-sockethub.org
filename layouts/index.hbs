{{>header}}

<section class="hero">
  <div class="container hero-content">
    <img src="/res/img/sockethub-logo.svg" alt="Sockethub" class="hero-logo" width="352" height="112">
    <p class="hero-eyebrow">Protocol gateway for the web</p>
    <h1 class="hero-title">
      Chat, email, feeds, calendars, contacts, and link previews through one API.
    </h1>
    <p class="hero-subtitle">
      Sockethub lets browser apps talk to IRC, XMPP, email, RSS/Atom feeds, CalDAV calendars, CardDAV contacts,
      Messenger, Instagram, WhatsApp and more, all through a single <strong><a href="https://www.w3.org/TR/activitystreams-core/">ActivityStreams 2.0</a></strong> message format.
    </p>

    <div class="hero-actions">
      <a class="button is-primary is-large" href="https://github.com/sockethub/sockethub" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5A11.5 11.5 0 0 0 .5 12.2c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.3 1.8 1.3 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.9 18 5.2 18 5.2c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.7 5.6-5.3 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6a11.6 11.6 0 0 0 7.9-11C23.5 5.6 18.3.5 12 .5z"/>
        </svg>
        View on GitHub
      </a>
      <a class="button is-light is-large" href="/about">How it works</a>
    </div>

    <div class="hero-install" aria-label="Install Sockethub">
      <span class="hero-install__prompt" aria-hidden="true">$</span>
      <code class="hero-install__cmd">{{installCommand}}</code>
      <span class="hero-install__version">v{{site.release.version}}</span>
    </div>
  </div>
</section>

<section class="container prose" style="padding-block: var(--space-xl);" aria-labelledby="use-cases-title">
  <h2 id="use-cases-title">What are you building?</h2>
  <p><a href="/use-cases/web-chat/">Add IRC and XMPP chat to your web app</a> so people can join existing channels and conversations.</p>
  <p><a href="/use-cases/rss-reader/">Build a web-based RSS reader</a> that fetches feeds even when publishers don't allow browser requests.</p>
  <p><a href="/use-cases/link-previews/">Show link previews in your chat or bookmark app</a> with a title, description, and image for shared URLs.</p>
  <p><a href="/use-cases/ics-calendar/">Show upcoming events from an ICS calendar</a> on a community website or personal dashboard.</p>
</section>

