        <path class="fanout__line" d="M456,381 Q540,381 620,45"/>
        <path class="fanout__line" d="M456,381 Q540,381 620,129"/>
        <path class="fanout__line" d="M456,381 Q540,381 620,213"/>
        <path class="fanout__line" d="M456,381 Q540,381 620,297"/>
        <path class="fanout__line" d="M456,381 Q540,381 620,381"/>
        <path class="fanout__line" d="M456,381 Q540,381 620,465"/>
        <path class="fanout__line" d="M456,381 Q540,381 620,549"/>
