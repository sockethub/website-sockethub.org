{
	"$id": "https://sockethub.org/schemas/3.0.0-alpha.21/examples-config.json",
	"description": "Sockethub examples runtime configuration",
	"type": "object",
	"required": [
		"sockethub",
		"public"
	],
	"additionalProperties": false,
	"properties": {
		"sockethub": {
			"type": "object",
			"required": [
				"port",
				"host",
				"path"
			],
			"additionalProperties": false,
			"properties": {
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"host": {
					"type": "string"
				},
				"path": {
					"type": "string"
				}
			}
		},
		"public": {
			"type": "object",
			"required": [
				"protocol",
				"host",
				"port",
				"path"
			],
			"additionalProperties": false,
			"properties": {
				"protocol": {
					"type": "string"
				},
				"host": {
					"type": "string"
				},
				"port": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"path": {
					"type": "string"
				}
			}
		},
		"platforms": {
			"type": "array",
			"items": {
				"type": "string"
			}
		}
	}
}