{
  "required": [
    "object"
  ],
  "properties": {
    "object": {
      "type": "object",
      "required": [
        "type",
        "token",
        "apiVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "credentials"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\r\\n]+$"
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^v[0-9]{1,3}\\.[0-9]{1,2}$"
        }
      }
    }
  }
}