{
  "required": [
    "object"
  ],
  "properties": {
    "object": {
      "type": "object",
      "required": [
        "type",
        "token",
        "apiVersion"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "login",
            "pageId"
          ],
          "properties": {
            "login": {
              "const": "facebook"
            }
          }
        },
        {
          "properties": {
            "login": {
              "const": "instagram"
            }
          },
          "not": {
            "required": [
              "pageId"
            ]
          }
        }
      ],
      "properties": {
        "login": {
          "enum": [
            "instagram",
            "facebook"
          ]
        },
        "pageId": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 128
        },
        "type": {
          "const": "credentials"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^[^\\r\\n]+$"
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^v[0-9]{1,3}\\.[0-9]{1,2}$"
        }
      }
    }
  }
}